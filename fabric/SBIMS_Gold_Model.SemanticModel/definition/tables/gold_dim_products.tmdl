table gold_dim_products
	lineageTag: 9c249f92-fc5a-40d4-a249-a835efc05d87
	sourceLineageTag: [dbo].[gold_dim_products]

	measure 'Products Generating Losses' =
			
			VAR LossMakingProducts =
			    FILTER(
			        VALUES(gold_dim_products[ProductName]),
			        CALCULATE(SUM(gold_fact_sales[GrossProfit])) < 0
			    )
			RETURN
			    COUNTROWS(LossMakingProducts)
		formatString: 0
		lineageTag: ed70588e-43cf-4d0c-a93e-141605aabe36

		changedProperty = Name

		changedProperty = IsHidden

