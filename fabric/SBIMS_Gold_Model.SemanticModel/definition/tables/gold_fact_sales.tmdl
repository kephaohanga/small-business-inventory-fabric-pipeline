table gold_fact_sales
	lineageTag: d6c77e7d-4b95-4335-ac68-9f416d957f60
	sourceLineageTag: [dbo].[gold_fact_sales]

	measure 'Total Revenue' = SUM(gold_fact_sales[Revenue])
		lineageTag: 3a003964-8391-4cdf-a60e-d986a1a30b03

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cost' = SUM(gold_fact_sales[Cost])
		lineageTag: c26f2b36-f2a1-4832-b3fb-0a385ba1219b

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit' = SUM(gold_fact_sales[GrossProfit])
		lineageTag: aad812be-fd75-4409-a63c-fd4aefd3a4c5

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Transactions' = COUNTROWS(gold_fact_sales)
		formatString: 0
		lineageTag: 2916ce59-9cd5-41be-aeed-7ffb0edcebee

		changedProperty = Name

		changedProperty = IsHidden

	measure 'Total Expenses' = SUM(gold_fact_expenses[Amount])
		lineageTag: 2b1d8449-87d5-4867-8319-50c9ffbb0589

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' =
			
			DIVIDE(
			    SUM(gold_fact_sales[GrossProfit]),
			    SUM(gold_fact_sales[Revenue]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: acf37287-6069-4804-b8ad-1666d3087586

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Is Loss-Making Product' =
			
			IF(
			    CALCULATE(SUM(gold_fact_sales[GrossProfit])) < 0,
			    "Yes",
			    "No"
			)
		lineageTag: e4cd4ff4-8a1f-46c9-9301-ba876e9308ba

		changedProperty = Name

		changedProperty = IsHidden

	measure 'Net Profit' = [Gross Profit] - [Total Expenses]
		lineageTag: be9f3d39-4826-43ca-b2a8-a663e4ab0acf

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Margin %' = DIVIDE([Net Profit], [Total Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 10813cf5-20f5-4752-854e-59d4fac701f4

		changedProperty = Name

		changedProperty = FormatString

	measure 'Revenue per Employee' = DIVIDE([Total Revenue], DISTINCTCOUNT(gold_fact_sales[EmployeeID]))
		lineageTag: f7077591-1734-48c0-845e-12d875047700

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Employees = DISTINCTCOUNT(gold_fact_sales[EmployeeID])
		formatString: 0
		lineageTag: e511934c-8769-4d5b-a346-c01e3a08fc33

		changedProperty = Name

	measure 'Sales Transactions' = CALCULATE(COUNTROWS(gold_fact_sales), gold_fact_sales[TransactionType] = "Income")
		formatString: 0
		lineageTag: cf329570-83d2-4687-b1fe-d2da5bbbedac

		changedProperty = Name

