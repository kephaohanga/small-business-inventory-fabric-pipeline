ref table gold_dim_branches
ref table gold_fact_stock_reconciliation
ref table gold_dim_employees
ref table gold_dim_products
ref table gold_fact_stock_ledger
ref table gold_fact_expenses
ref table gold_fact_stock_purchases
ref table gold_dim_payment_methods
ref table gold_fact_sales
ref table gold_fact_stock_adjustments
ref table gold_dim_date
ref table gold_dim_expense_categories

